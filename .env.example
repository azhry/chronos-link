# === Chronos-Link-V1 Configuration ===

# --- 1. LLM Provider (REQUIRED) ---
# Options: google, ollama, anthropic
LLM_PROVIDER=google
LLM_MODEL=gemini-2.0-flash

# --- 2. Provider Credentials (REQUIRED based on provider) ---
# If provider is 'google'
GEMINI_API_KEY=

# If provider is 'anthropic'
# ANTHROPIC_API_KEY=

# If provider is 'openrouter'
# OPENROUTER_API_KEY=
# LLM_MODEL=anthropic/claude-3.5-sonnet:beta

# If provider is 'ollama'
# OLLAMA_BASE_URL=http://localhost:11434

# --- 3. Optional Settings ---
# K_WINDOW=5             # Number of past ADRs for context
# MAX_ITERATIONS=3       # Max Actor-Critic loop iterations
# WORKSPACE_ROOT=.       # Root path of the project to analyze
# ADR_OUTPUT_DIR=docs/adr # Where to save generated ADRs